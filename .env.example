# Server
NODE_ENV=development
PORT=4000

# MySQL Database (cPanel MySQL / local MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=community_center
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=8

# Authentication (change JWT_SECRET to a long random string in production!)
JWT_SECRET=change-this-to-a-long-random-secret-key-at-least-32-chars
JWT_EXPIRES_IN=1d
JWT_REMEMBER_EXPIRES_IN=30d

# Comma-separated allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:3000,https://hmyvalibhoycc-dhari.com,https://www.hmyvalibhoycc-dhari.com

# Rate limiting (requests per 15 min window per IP)
RATE_LIMIT_MAX=300

